---
import { markdown } from '@astropub/md';

import type { Scroller } from '../../lib/content-schema';

interface Props {
  scroller: Scroller;
}

const { scroller } = Astro.props;
---

<section class="scroller relative z-2">
  
  {/* Zoom wrapper */}
  <div class="scroller__zoom_wrapper overflow-hidden sticky top-0 z-3 h-screen bg-linear-to-br from-[#4e8c6f] to-[#7da596]">

    {/* Zoom container */}
    <div class="scroller__zoom_container flex justify-center items-center h-screen p-2 sm:p-1 md:p-3 lg:p-5 xl:p-12 2xl:p-13">

      {/* Zoomed object */}
      <div class="scroller__zoom relative origin-center transition-transform will-change-transform duration-1000 ease-in-out">
        
        <img src={scroller.image} alt="Zoom background"/>

        {/* Hotspots boxes */}
        {scroller.blocks.map(block => (
          <>
          {block.type === 'hotspots' && (
            <div 
            class="scroller__zoom_box absolute border md:border-2 border-white rounded-sm hidden"
            style={`left:${block.frame.x}%; top:${block.frame.y}%; width:${block.frame.width}%; height:${block.frame.height}%`}
            data-id={block.id}
            >
            </div>
          )}
          </>
        ))}

      </div>

    </div>

  </div>

  {/* Scroller scene */}
  <div class="scroller__scene relative overflow-hidden z-10 mt-[-15vh] md:mt-[-16vh] lg:mt-[-50vh]">

    {/* Scroller wrapper */}
    <div class="scroller__content-wrapper">

      {/* Scroller content layout */}
      <div class="scroller__content-layout sm:max-w-225 md:max-w-262.5 lg:max-w-265 xl:max-w-340 2xl:max-w-[1560px] mx-auto">

        {/* Map the texts and hotspots */}
        {scroller.blocks.map((block, index) => (

            <div 
              class:list={[
                "flex flex-wrap items-center justify-center z-50 pb-[30vh]",
                index !== 0 ? 'pt-[50vh]' : ''
              ]}
              >

              {/* Scroller content layer */}
              <div class:list={[
                  'scroller__content-layer box-border block basis-0 grow w-[95%] max-w-full pl-0 pr-0 mx-auto sm:max-w-[83.3333%] md:max-w-[50%] sm:flex-[83.3333%] md:flex-[50%]',
                  block.type === 'hotspots'
                    ? block.side === 'right' ? 'md:mr-0' : 'md:ml-0' 
                    : ''
                ]}
                {...(block.type === 'hotspots' ? { 'data-type': 'hotspot', 'data-id': block.id, 'data-x': block.frame.x, 'data-y': block.frame.y, 'data-width': block.frame.width, 'data-height': block.frame.height, 'data-side': block.side } : { 'data-type': 'text' })}
              >
                <div
                  class='scroller__content box-border p-8 bg-white/85 rounded-xl text-[17px] sm:text-[18px] lg:text-[20px] 2xl:text-[22px] font-[Open_Sans] space-y-6 [&_a]:text-blue-600 [&_a]:font-medium [&_a]:underline [&_a:hover]:text-blue-800'
                >

                  {/* Text block type */}
                  {block.type === 'texts' && (
                      <div class="space-y-6 leading-[1.7] font-normal" set:html={ markdown(block.text) } />
                  )}

                  {/* Hotspot block type */}
                  {block.type === 'hotspots' && (
                    <>
                      <h3 class="text-[250%] md:text-[180%] uppercase font-[WWF]">{block.title}</h3>

                      {block.content.map((content) => (
                        content.type === 'text' ? (
                          <div class="space-y-6 leading-[1.7] font-normal" set:html={ markdown(content.content) } />
                        ) : (
                          <figure class="mt-6">
                            <img
                              src={content.image.src}
                              alt={content.image.alt}
                            />

                            {content.image.caption && (
                              <figcaption class="text-[0.8em] text-center p-[0.5em] leading-[1.2]">{content.image.caption}</figcaption>
                            )}
                          </figure>
                        )
                      ))}
                    </>
                  )}
                </div>
              </div>
          </div>
          ))}
      </div>
    </div>
  </div>

</section>

<script>
  // Small helper : getAttribute() return `string | null`, which
  // does not satisfy parseFloat (should be a `string`).
  const getAttrNumber = (el: Element, name: string): number =>
    parseFloat(el.getAttribute(name) ?? '0');

  const bg = document.querySelector<HTMLElement>('.scroller__zoom');
  const layers = document.querySelectorAll('.scroller__content-layer');
  const boxes = document.querySelectorAll('.scroller__zoom_box');

  // Beyond this threshold, the zoomed box aligns with the width of the
  // corresponding content div and positions itself in the opposite half of the screen.
  const DESKTOP_BREAKPOINT = 900;

   if (bg && layers.length) {

    // observer
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        
        // only trigger when element is in the view
        if (entry.isIntersecting) {

          // hide all the boxes hideBoxes
          boxes.forEach(box => {
            box.classList.remove('block');
            box.classList.add('hidden');
          });

          // get the data attributes
          const type = entry.target.getAttribute('data-type');
          
          // hotspot
          if (type === 'hotspot') {
            const id = entry.target.getAttribute('data-id');
            const side = entry.target.getAttribute('data-side'); // 'left' | 'right'
            const x = getAttrNumber(entry.target, 'data-x');
            const y = getAttrNumber(entry.target, 'data-y');
            const width = getAttrNumber(entry.target, 'data-width');
            const height = getAttrNumber(entry.target, 'data-height');

            const isDesktop = window.innerWidth >= DESKTOP_BREAKPOINT;

            // Default (mobile): the box takes up 75% of the container and is centered.
            let targetFillX = 75;
            const targetFillY = 75;
            let targetCenterX = 50;
            const targetCenterY = 50;

            if (isDesktop) {
              // Target width = actual width (in px) of the corresponding content-layer,
              // expressed as a percentage of the static width of .scroller__zoom.
              const zoomWidth = bg.offsetWidth || 1;
              const layerWidth = entry.target.getBoundingClientRect().width;
              targetFillX = (layerWidth / zoomWidth) * 100;

              // The box must appear in the half opposite the text block.
              targetCenterX = side === 'right' ? 25 : 75;
            }

            // We keep the smaller of the two factors to avoid exceeding the limits in either width or height.
            const zoomX = width > 0 ? targetFillX / width : 1;
            const zoomY = height > 0 ? targetFillY / height : 1;
            const zoomFactor = Math.min(zoomX, zoomY);

            // Hotspot center (not its top-left corner): this is the point we want
            // to align with the center of the target area (50/50 on mobile, 25 or 75 on desktop).
            const centerX = x + width / 2;
            const centerY = y + height / 2;

            // Anime.js always applies transforms in the order translate -> scale
            // (translate on the outside). General formula to move centerX/centerY to
            // targetCenterX/targetCenterY: zoomFactor * (50 - center%) + (target - 50).
            const translateX = zoomFactor * (50 - centerX) + (targetCenterX - 50);
            const translateY = zoomFactor * (50 - centerY) + (targetCenterY - 50);

            // show coresponding box
            const box = document.querySelector(`.scroller__zoom_box[data-id="${id}"]`);
            box?.classList.remove('hidden');
            box?.classList.add('block');

            bg.style.transform = `translate(${translateX}%, ${translateY}%) scale(${zoomFactor})`;

          } else {
            // simple text
            bg.style.transform = 'translate(0%, 0%) scale(1)';
          }
          
        }
      });
    }, {
      threshold: 0.1
    });

    // observe the text and hotspots
    layers.forEach(el => {
      observer.observe(el);
    });
  }
</script>